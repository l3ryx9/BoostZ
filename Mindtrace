## 6. SCHÉMA SQLITE

Toutes les colonnes texte métier sont des blobs chiffrés `TEXT`. Les métadonnées en clair sont limitées à ce qui est listé.

```sql
schema_version(version INTEGER PRIMARY KEY, applied_at INTEGER NOT NULL);

entries(
  id TEXT PRIMARY KEY,            -- uuid v4, clair
  created_at INTEGER NOT NULL,    -- epoch ms, clair
  updated_at INTEGER NOT NULL,    -- epoch ms, clair
  entry_date TEXT NOT NULL,       -- YYYY-MM-DD, clair (index/calendrier)
  title_enc TEXT,                 -- null si absent
  body_enc TEXT NOT NULL,
  mood_intensity INTEGER,         -- 1..10, clair
  is_favorite INTEGER NOT NULL DEFAULT 0,
  is_important INTEGER NOT NULL DEFAULT 0,
  week_bucket TEXT NOT NULL,      -- YYYY-Www, clair
  synth_id TEXT REFERENCES syntheses(id)
);
CREATE INDEX idx_entries_date ON entries(entry_date DESC);
CREATE INDEX idx_entries_bucket ON entries(week_bucket, synth_id);

emotions(id TEXT PRIMARY KEY, label_enc TEXT NOT NULL, color TEXT NOT NULL, is_custom INTEGER NOT NULL DEFAULT 0, sort_order INTEGER NOT NULL);
entry_emotions(entry_id TEXT NOT NULL REFERENCES entries(id) ON DELETE CASCADE, emotion_id TEXT NOT NULL REFERENCES emotions(id), PRIMARY KEY(entry_id, emotion_id));

tags(id TEXT PRIMARY KEY, label_enc TEXT NOT NULL UNIQUE);
entry_tags(entry_id TEXT NOT NULL REFERENCES entries(id) ON DELETE CASCADE, tag_id TEXT NOT NULL REFERENCES tags(id), PRIMARY KEY(entry_id, tag_id));

syntheses(
  id TEXT PRIMARY KEY,
  period_start TEXT NOT NULL,
  period_end TEXT NOT NULL,
  kind TEXT NOT NULL,             -- 'weekly' | 'monthly'
  payload_enc TEXT NOT NULL,      -- JSON structuré
  schema_version INTEGER NOT NULL,
  idempotency_key TEXT NOT NULL UNIQUE,
  prompt_version TEXT NOT NULL,
  model TEXT NOT NULL,
  created_at INTEGER NOT NULL
);

conversations(id TEXT PRIMARY KEY, title_enc TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL);
messages(id TEXT PRIMARY KEY, conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE, role TEXT NOT NULL, content_enc TEXT NOT NULL, context_mode INTEGER NOT NULL, created_at INTEGER NOT NULL);

api_calls(
  id TEXT PRIMARY KEY,
  idempotency_key TEXT NOT NULL UNIQUE,
  kind TEXT NOT NULL,
  period_start TEXT, period_end TEXT,
  entry_ids_hash TEXT,
  tokens_in INTEGER, tokens_out INTEGER,
  status TEXT NOT NULL,           -- 'pending' | 'success' | 'error' | 'cancelled'
  http_status INTEGER, error_code TEXT,
  started_at INTEGER NOT NULL, finished_at INTEGER,
